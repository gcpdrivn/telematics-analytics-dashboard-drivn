# Copy this file to .env and fill in your values.
# Auth: this pipeline uses Application Default Credentials, not a key file.
# Run `gcloud auth application-default login` (or attach a service identity
# in prod) before running the pipeline.

GCP_PROJECT_ID=your-gcp-project-id
BQ_DATASET=telematics
BQ_LOCATION=asia-south1
BQ_UTILIZATION_TABLE=utilization_daily
BQ_INGESTION_LOG_TABLE=ingestion_log
BQ_MILEAGE_SOC_TABLE=vehicle_mileage_soc
BQ_DIM_CUSTOMER_TABLE=dim_customer
BQ_DIM_VEHICLE_TABLE=dim_vehicle

# Folder the pipeline scans for *.xlsx utilization reports.
# Relative paths resolve against the repo root.
RAW_UTILIZATION_DIR=data/raw/utilization

# Single mileage/SoC benchmark workbook (not a growing folder -- replaced
# wholesale in BigQuery on every ingest-mileage-soc run).
MILEAGE_SOC_FILE=data/raw/vehicle_mileage_soc.xlsx
