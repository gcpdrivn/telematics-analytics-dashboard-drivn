# Copy this file to .env and fill in your values.
# Auth: this pipeline uses Application Default Credentials, not a key file.
# Run `gcloud auth application-default login` (or attach a service identity
# in prod) before running the pipeline.

GCP_PROJECT_ID=your-gcp-project-id
BQ_DATASET=telematics
BQ_LOCATION=asia-south1
BQ_UTILIZATION_TABLE=utilization_daily
BQ_INGESTION_LOG_TABLE=ingestion_log
BQ_MILEAGE_SOC_TABLE=vehicle_mileage_soc
BQ_DIM_CUSTOMER_TABLE=dim_customer
BQ_DIM_VEHICLE_TABLE=dim_vehicle

# Folder the pipeline scans for *.xlsx utilization reports.
# Relative paths resolve against the repo root.
RAW_UTILIZATION_DIR=data/raw/utilization

# Single mileage/SoC benchmark workbook (not a growing folder -- replaced
# wholesale in BigQuery on every ingest-mileage-soc run).
MILEAGE_SOC_FILE=data/raw/vehicle_mileage_soc.xlsx

# Fleetx API (see docs/Fleetx_Drivn_API_Integration_Guide_1.pdf) -- used by
# the Phase 0 reconnaissance script (ingestion/api_explore.py) and, later,
# the live-API ingestion pipeline. Never commit real values for these.
FLEETX_BASE_URL=https://api.fleetx.io
FLEETX_CLIENT_ID=fleetxweb
FLEETX_USERNAME=your-fleetx-api-username
FLEETX_PASSWORD=your-fleetx-api-password

# Which utilization table the backend dashboard reads: "excel" (default,
# utilization_daily) or "api" (utilization_daily_api, the Fleetx-API shadow
# table). Restart the backend after changing this -- it's read once at
# startup, not per-request. Active source is visible at GET /api/health.
UTILIZATION_SOURCE=excel

# Which daily-distance number every KPI/chart/uptime-classification reads:
# "reported" (default, the raw Distance field) or "odometer"
# (distance_by_odometer from odometer_daily_resolved -- see
# ingestion/odometer_resolver.py). Restart the backend after changing this --
# same rule as UTILIZATION_SOURCE above. Active source is visible at
# GET /api/health. Requires `uv run resolve-odometer` to have been run at
# least once so odometer_daily_resolved has data.
DISTANCE_SOURCE=reported

# Deployed dashboard backend base URL. When set, `seed-dimensions` /
# `backfill-vehicles` clear its cache (POST /api/admin/refresh-cache) right
# after loading a new vehicle's history, so the dashboard shows it at once.
# Leave empty to just wait for the cache TTL (BACKEND_CACHE_TTL_SECONDS).
BACKEND_URL=
